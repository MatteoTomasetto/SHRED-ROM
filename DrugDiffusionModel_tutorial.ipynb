        "# CHECK OBSERVABILITY\n",
        "\n",
        "mu = 0.3\n",
        "A = assembly(mu)\n",
        "\n",
        "C = [1, 0, 0]\n",
        "O = np.array([C, np.dot(C, A), np.dot(C, A*A)])\n",
        "if np.linalg.matrix_rank(O) == nstate:\n",
        "    print('The system is observable')\n",
        "else:\n",
        "    print('The system is not observable')"
      ]
