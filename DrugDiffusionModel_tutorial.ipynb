        "# DEFINE SHRED MODEL\n",
        "\n",
        "class SHRED(torch.nn.Module):\n",
        "\n",
        "    def __init__(self, input_size, output_size, hidden_size = 64, hidden_layers = 2, decoder_sizes = [350, 400], dropout = 0.0):\n",
        "        '''\n",
